{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Greenlight: open UI",
      "type": "shell",
      "command": "dotnet run greenlight.cs -- --ui",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Greenlight: build manifest",
      "type": "shell",
      "command": "dotnet run greenlight.cs -- ${input:key} --fetch",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Greenlight: install git hooks in all repos",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File install-hooks.ps1",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    { "id": "key", "type": "promptString", "description": "Jira key, e.g. MM-1234" }
  ]
}
